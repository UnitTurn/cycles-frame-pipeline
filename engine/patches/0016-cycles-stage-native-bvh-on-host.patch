+bool Film::geometry_passes_will_change(const Scene &scene) const
+{
+  /* update_passes() rebuilds automatic passes. UV and motion can be requested explicitly,
+   * as the display pass, or (motion only) as denoiser inputs. A change invalidates geometry
+   * buffers, so staged geometry must wait until the film has issued those updates. */
+  const PassType display_pass = get_display_pass();
+  bool have_uv = display_pass == PASS_UV;
+  bool have_motion = display_pass == PASS_MOTION || display_pass == PASS_DENOISING_BACKWARD_MOTION;
+  for (const Pass *pass : scene.passes) {
+    if (!pass->is_auto_) {
+      const PassType type = pass->get_type();
+      have_uv |= type == PASS_UV;
+      have_motion |= type == PASS_MOTION || type == PASS_DENOISING_BACKWARD_MOTION;
+    }
+  }
+  if (scene.integrator->get_use_denoise()) {
+    const DenoiserPassMask denoiser_passes = scene.integrator->get_denoiser_passes();
+    have_motion |= (denoiser_passes & (DENOISER_PASS_MOTION | DENOISER_PASS_BACKWARD_MOTION)) != 0;
+  }
+  return have_uv != prev_have_uv_pass || have_motion != prev_have_motion_pass;
+}
