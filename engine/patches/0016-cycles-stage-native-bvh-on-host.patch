+bool GeometryManager::prepare_host_bvh(Device *device, Scene *scene, Progress &progress)
+{
+  if (!need_update() || !scene->procedurals.empty() || !device->info.multi_devices.empty() ||
+      (device->info.type != DEVICE_HIP && device->info.type != DEVICE_CUDA) ||
+      device->get_bvh_layout_mask(0) != BVH_LAYOUT_BVH2) {
+    formal_frame_mark_stage("host_bvh_ineligible_scene");
+    return false;
+  }
+  if (scene->film->geometry_passes_will_change(*scene)) {
+    formal_frame_mark_stage("host_bvh_ineligible_render_pass_change");
+    return false;
+  }
+  /* CPU compilation has not yet updated shader feature flags. Only materials actually used by
+   * geometry can affect this BVH. An evaluated volume mesh or true displacement may require
+   * target-device values. Keep those scenes on the normal native update path. */
+  for (Geometry *geom : scene->geometry) {
+    if (geom->is_light()) {
+      continue;
+    }
+    for (Node *node : geom->get_used_shaders()) {
+      if (node->is_modified()) {
+        formal_frame_mark_stage("host_bvh_ineligible_shader");
+        return false;
+      }
+    }
+    if (geom->is_volume() && (geom->is_modified() || (update_flags & VOLUME_MODIFIED))) {
+      formal_frame_mark_stage("host_bvh_ineligible_volume");
+      return false;
+    }
+    if (geom->is_mesh() && geom->is_modified()) {
+      Mesh *mesh = static_cast<Mesh *>(geom);
+      if (mesh->need_tesselation() || (mesh->num_triangles() && mesh->has_true_displacement())) {
+        formal_frame_mark_stage("host_bvh_ineligible_mesh_evaluation");
+        return false;
+      }
+    }
+  }
+  const Scene::MotionType motion = scene->need_motion();
+  if (motion != Scene::MOTION_NONE && scene->object_manager->need_update()) {
+    if (motion != Scene::MOTION_BLUR) {
+      /* In a vector pass the native object path captures the center transform before it
+       * hides particles with missing steps. Preserve that sequencing on its normal path. */
+      for (Object *ob : scene->objects) {
+        if (ob->get_hide_on_missing_motion() && ob->use_motion() &&
+            std::find(ob->get_motion().begin(), ob->get_motion().end(), transform_empty()) !=
+                ob->get_motion().end()) {
+          formal_frame_mark_stage("host_bvh_ineligible_missing_motion");
+          return false;
+        }
+      }
+    }
+    for (Object *ob : scene->objects) {
+      ob->update_motion();
+    }
+  }
+
+  auto staged = make_unique<HostPreparedBVH>();
+  staged->buffer_flags = preprocess_geometry_flags(device, scene, progress);
+  prepare_meshes(scene, progress, staged->displacement_images, staged->curve_transparency);
+  if (progress.get_cancel()) {
+    return false;
+  }
+
+  /* The native mesh/instance offsets and transformed geometry are authoritative for this frame.
+   * Applying the object flag to device-scene buffers still happens at normal device update. */
+  geom_calc_offset(scene, BVH_LAYOUT_BVH2);
+  const bool keep_geometry_bvhs = keep_local_bvhs(device, scene, BVH_LAYOUT_BVH2);
+  if (scene->params.bvh_type == BVH_TYPE_STATIC && !keep_geometry_bvhs) {
+    scene->object_manager->apply_static_transforms(nullptr, scene, progress);
+  }
+
+  /* CPU-only arguments used by BVH2; none of the device vectors in this local are allocated. */
+  DeviceScene host_inputs(device);
+  for (Object *object : scene->objects) {
+    if (object->get_geometry()->is_hair()) {
+      host_inputs.data.bvh.have_curves = true;
+      break;
+    }
+  }
+  if (staged->buffer_flags & (DEVICE_MESH_DATA_NEEDS_REALLOC | DEVICE_CURVE_DATA_NEEDS_REALLOC |
+                              DEVICE_POINT_DATA_NEEDS_REALLOC)) {
+    scene->bvh.reset();
+  }
+  staged->needs_tree = build_geometry_bvhs(
+      device, &host_inputs, scene, progress, BVH_LAYOUT_BVH2, keep_geometry_bvhs);
+  compute_object_bounds(scene);
+  if (progress.get_cancel()) {
+    return false;
+  }
+  if (staged->needs_tree) {
+    build_scene_bvh(device, &host_inputs, scene, progress);
+    if (progress.get_cancel()) {
+      return false;
+    }
+    staged->tree = std::move(scene->bvh);
+    formal_frame_mark_stage("host_bvh_ready");
+  }
+  else {
+    formal_frame_mark_stage("host_bvh_unchanged");
+  }
+  host_bvh_ = std::move(staged);
+  return true;
+}
