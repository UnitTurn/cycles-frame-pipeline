+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include "util/unique_ptr.h"
+
+CCL_NAMESPACE_BEGIN
+class BVHBuild;
+class BVHNode;
+class BVHRange;
+class BVHObjectBinning;
+struct PackedBVH;
+class BVHExactFrames;
+
+/* Stores disjoint native partitions. The upper levels always execute the
+ * original binner before testing a partition's complete ordered inputs. */
+class BVHExactPartitions {
+ public:
+  static constexpr int depth = 5;
+  BVHExactPartitions();
