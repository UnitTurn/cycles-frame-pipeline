+/* SPDX-License-Identifier: Apache-2.0 */
+#include "bvh/exact_frame.h"
+#include "bvh/binning.h"
+#include "bvh/build.h"
+#include "bvh/bvh.h"
+#include "bvh/node.h"
+#include "scene/geometry.h"
+#include "scene/object.h"
+#include "util/md5.h"
+#include "util/progress.h"
+#include <array>
+#include <bit>
+#include <chrono>
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <future>
+#include <thread>
+#ifdef _WIN32
+#  include "util/windows.h"
