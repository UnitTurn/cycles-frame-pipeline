+/* SPDX-License-Identifier: Apache-2.0 */
+
+#include "bvh/frame_lookahead.h"
+
+#include "bvh/build.h"
+#include "bvh/frame_snapshot.h"
+#include "bvh/node.h"
+#include "scene/object.h"
+#include "util/progress.h"
+
+#include <charconv>
+#include <chrono>
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <future>
+#include <numeric>
+#include <tuple>
+#ifdef _WIN32
+#  include "util/windows.h"
+#endif
+
+CCL_NAMESPACE_BEGIN
+
+namespace {
+using Ref = framepipe::SnapshotRef;
+using Refs = std::vector<Ref>;
+namespace fs = std::filesystem;
+
+fs::path env_value(const char *name)
+{
+#ifdef _WIN32
+  const std::wstring key(name, name + std::strlen(name));
+  const DWORD count = GetEnvironmentVariableW(key.c_str(), nullptr, 0);
+  if (count == 0) {
+    return {};
+  }
+  std::wstring value(count, L'\0');
+  const DWORD used = GetEnvironmentVariableW(key.c_str(), value.data(), count);
+  if (!used || used >= count) {
+    return {};
+  }
+  value.resize(used);
+  return value;
+#else
+  const char *value = std::getenv(name);
+  return value ? fs::path(value) : fs::path();
+#endif
+}
+
+size_t max_refs()
+{
+  const std::string limit = env_value("CYCLES_FRAMEPIPE_MAX_REFS").string();
+  if (limit.empty()) {
+    return 1000000;
+  }
+  size_t value = 0;
+  const auto result = std::from_chars(limit.data(), limit.data() + limit.size(), value);
+  return (result.ec == std::errc() && result.ptr == limit.data() + limit.size()) ?
+             std::min<size_t>(value, INT_MAX / 8) :
+             0;
+}
+
+/* Budget both inputs, native build nodes, primitive outputs and sorting scratch.
+ * A second check at launch accounts for the current frame's scene/device upload. */
+size_t memory_limit(size_t requested, size_t bytes_per_ref = 768)
+{
+#ifdef _WIN32
+  MEMORYSTATUSEX mem = {};
+  mem.dwLength = sizeof(mem);
+  if (!GlobalMemoryStatusEx(&mem)) {
+    return 0;
+  }
+  constexpr uint64_t reserved = 768ULL << 20;
+  const uint64_t free = std::min(mem.ullAvailPhys, mem.ullAvailPageFile);
+  const uint64_t budget = (free > reserved) ? free - reserved : 0;
+  return std::min(requested, size_t(budget / bytes_per_ref));
+#else
+  (void)bytes_per_ref;
+  return requested;
+#endif
+}
+
+BoundBox box(const Ref &ref)
+{
+  return BoundBox(make_float3(ref.lo[0], ref.lo[1], ref.lo[2]),
+                  make_float3(ref.hi[0], ref.hi[1], ref.hi[2]));
+}
+
+auto key(const Ref &ref)
+{
+  return std::make_tuple(ref.prim_object, ref.prim_index, ref.prim_type);
+}
+
+bool supported(const Ref &ref)
+{
+  return framepipe::valid_snapshot_ref(ref) &&
+         ((ref.prim_index == -1 && ref.prim_type == 0) ||
+          (ref.prim_index >= 0 &&
+           (ref.prim_type == PRIMITIVE_TRIANGLE || ref.prim_type == PRIMITIVE_POINT)));
+}
+
+/* Refit an already partitioned, aligned binary hierarchy. The native leaf
+ * grouping and primitive order remain intact. Every mask and every bound is
+ * assigned from the current frame, including unchanged siblings. */
+void refit(BVHNode &node, const Refs &actual, const std::vector<int> &input_for_slot)
+{
+  node.bounds = BoundBox::empty;
+  node.visibility = 0;
+  if (node.is_leaf()) {
+    const auto &leaf = static_cast<const LeafNode &>(node);
+    for (int slot = leaf.lo; slot < leaf.hi; ++slot) {
+      const Ref &ref = actual[input_for_slot[slot]];
+      node.bounds.grow(box(ref));
+      node.visibility |= ref.visibility;
+    }
+    return;
+  }
+  for (int i = 0; i < node.num_children(); ++i) {
+    BVHNode &child = *node.get_child(i);
+    refit(child, actual, input_for_slot);
+    node.bounds.grow(child.bounds);
+    node.visibility |= child.visibility;
+  }
+}
+}  // namespace
+
+struct BVHFrameLookahead::Job {
+  Refs source;
+  BVHParams params;
+  Progress progress;
+  std::atomic<bool> stop{false};
+  fs::path next;
+  size_t cap = 0;
+  size_t limit = 0;
+  size_t target = 0;
+  array<int> type, index, object;
+  array<float2> time;
+  unique_ptr<BVHNode> root;
+  std::vector<int> input_for_slot;
+};
+
+struct BVHFrameLookahead::State {
+  size_t generation = 0;
+  unique_ptr<Job> pending;
+  unique_ptr<Job> running;
+  std::future<void> active;
+};
+
+BVHFrameLookahead::BVHFrameLookahead() : state_(make_unique<State>()) {}
+BVHFrameLookahead::~BVHFrameLookahead()
+{
+  if (state_->active.valid()) {
+    state_->running->stop.store(true, std::memory_order_relaxed);
+    state_->active.wait();
+  }
+}
+
+bool BVHFrameLookahead::enabled()
+{
+  return env_value("CYCLES_BVH_LOOKAHEAD") == "1";
+}
+
+void BVHFrameLookahead::prepare(Job &job)
+{
+  /* An optional exact snapshot replaces the predictor from the previous frame.
+   * All input is validated before calling Cycles' native builder. */
+  const auto started = std::chrono::steady_clock::now();
+  bool using_baked = false;
+  if (!job.next.empty()) {
+    Refs baked;
+    if (framepipe::read_snapshot(job.next, job.limit, baked) && !baked.empty()) {
+      job.source.swap(baked);
+      using_baked = true;
+    }
+  }
+  const vector<Object *> no_objects;
+  BVHBuild detached(
+      no_objects, job.type, job.index, job.object, job.time, job.params, job.progress);
+  detached.detached_stop = &job.stop;
+  BoundBox bounds = BoundBox::empty, centers = BoundBox::empty;
+  detached.references.reserve(job.source.size());
+  int maximum_object = -1;
+  for (size_t i = 0; i < job.source.size(); ++i) {
+    const Ref &ref = job.source[i];
+    if (!supported(ref) || size_t(ref.prim_object) > job.limit ||
+        (i && !(key(job.source[i - 1]) < key(ref))) ||
+        (i && job.source[i - 1].prim_object == ref.prim_object &&
+         job.source[i - 1].visibility != ref.visibility))
+    {
+      return;
+    }
+    if ((i % 4096 == 0) && job.stop.load(std::memory_order_relaxed)) {
+      return;
+    }
+    maximum_object = std::max(maximum_object, ref.prim_object);
+    const BoundBox b = box(ref);
+    detached.references.emplace_back(b, ref.prim_index, ref.prim_object, ref.prim_type);
+    bounds.grow(b);
+    centers.grow(b.center2());
+  }
+  if (maximum_object < 0) {
+    return;
+  }
+  detached.snapshot_visibility.resize(size_t(maximum_object) + 1);
+  std::vector<size_t> object_offsets(size_t(maximum_object) + 2);
+  for (const Ref &ref : job.source) {
+    detached.snapshot_visibility[ref.prim_object] = ref.visibility;
+    ++object_offsets[ref.prim_object + 1];
+  }
+  std::partial_sum(object_offsets.begin(), object_offsets.end(), object_offsets.begin());
+  job.root = detached.build_references(BVHRange(bounds, centers, 0, int(job.source.size())));
+  if (!job.root || job.index.size() != job.source.size()) {
+    job.root.reset();
+    return;
+  }
+  /* Assign every native packed slot its original input. Work is done by the
+   * producer so the foreground handoff remains linear even with sparse IDs. */
+  job.input_for_slot.resize(job.source.size());
+  for (size_t s = 0; s < job.index.size(); ++s) {
+    const auto target = std::make_tuple(job.object[s], job.index[s], job.type[s]);
+    const size_t begin = object_offsets[job.object[s]], end = object_offsets[job.object[s] + 1];
+    /* Contiguous triangle/point indices and instances need a single lookup.
+     * Degenerate primitives can leave holes in that object's local numbering. */
+    size_t input = begin + size_t(int64_t(job.index[s]) - job.source[begin].prim_index);
+    if (input >= end || key(job.source[input]) != target) {
+      const auto it = std::lower_bound(job.source.begin() + begin,
+                                       job.source.begin() + end,
+                                       target,
+                                       [](const Ref &ref, const auto &k) { return key(ref) < k; });
+      input = size_t(it - job.source.begin());
+    }
+    if (input == end || key(job.source[input]) != target ||
+        ((s % 4096 == 0) && job.stop.load(std::memory_order_relaxed)))
+    {
+      job.root.reset();
+      return;
+    }
+    job.input_for_slot[s] = int(input);
+  }
+  const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() -
+                                                              started)
+                        .count();
+  std::fprintf(stderr,
+               "FRAMEPIPE_BVH prepared target=%zu input=%s refs=%zu build_ms=%.2f\n",
+               job.target,
+               using_baked ? "snapshot" : "prediction",
+               job.source.size(),
+               ms);
+}
+
+void BVHFrameLookahead::start()
+{
+  State &s = *state_;
+  if (!s.pending) {
+    return;
+  }
+  s.pending->limit = memory_limit(s.pending->limit);
+  if (s.pending->source.size() > s.pending->limit) {
+    std::fprintf(stderr,
+                 "FRAMEPIPE_BVH miss=memory stage=dispatch refs=%zu cap=%zu limit=%zu\n",
+                 s.pending->source.size(),
+                 s.pending->cap,
+                 s.pending->limit);
+    s.pending.reset();
+    return;
+  }
+  s.running = std::move(s.pending);
+  const size_t target = s.running->target, count = s.running->source.size();
+  try {
+    Job *job = s.running.get();
+    const int workers = std::max(1, TaskScheduler::max_concurrency() / 2);
+    s.active = std::async(std::launch::async, [job, workers] {
+      /* Keep the host render loop and the prior frame's CPU denoiser runnable. */
+      tbb::task_arena arena(workers, 1, tbb::task_arena::priority::low);
+      arena.execute([job] { prepare(*job); });
+    });
+    std::fprintf(stderr, "FRAMEPIPE_BVH launched target=%zu refs=%zu\n", target, count);
+  }
+  catch (const std::exception &e) {
+    s.running.reset();
+    std::fprintf(stderr, "FRAMEPIPE_BVH miss=launch (%s)\n", e.what());
+  }
+}
+
+unique_ptr<BVHNode> BVHFrameLookahead::exchange(BVHBuild &builder)
+{
+  State &s = *state_;
+  ++s.generation;
+  s.pending.reset(); /* Another sync before any path tracing. */
+  unique_ptr<Job> ready;
+  bool busy = false;
+  const fs::path capture = env_value("CYCLES_FRAMEPIPE_CAPTURE");
+  if (s.active.valid()) {
+    if (s.active.wait_for(std::chrono::seconds(0)) != std::future_status::ready) {
+      std::fprintf(stderr, "FRAMEPIPE_BVH miss=busy\n");
+      if (capture.empty()) {
+        return nullptr;
+      }
+      busy = true;
+    }
+    else {
+      try {
+        s.active.get();
+        ready = std::move(s.running);
+      }
+      catch (const std::exception &e) {
+        std::fprintf(stderr, "FRAMEPIPE_BVH miss=worker (%s)\n", e.what());
+        s.running.reset();
+      }
+    }
+  }
+  const size_t cap = max_refs(), limit = memory_limit(cap);
+  const size_t refs = builder.references.size();
+  const size_t exchange_limit = ready ? memory_limit(cap, sizeof(Ref)) : limit;
+  const char *reason = nullptr;
+  if (!builder.params.top_level) {
+    reason = "not-top-level";
+  }
+  else if (builder.params.use_unaligned_nodes) {
+    reason = "unaligned";
+  }
+  else if (refs == 0) {
+    reason = "empty";
+  }
+  else if (refs > cap) {
+    reason = "reference-cap";
+  }
+  else if (refs > exchange_limit) {
+    reason = "memory";
+  }
+  if (reason) {
+    std::fprintf(stderr,
+                 "FRAMEPIPE_BVH miss=%s stage=exchange refs=%zu cap=%zu limit=%zu\n",
+                 reason,
+                 refs,
+                 cap,
+                 exchange_limit);
+    return nullptr;
+  }
+  unique_ptr<BVHNode> result;
+  try {
+    Refs live;
+    live.reserve(builder.references.size());
+    /* An enabled time-step setting requests a prim_time array even when the
+     * TLAS contains only static primitives or instance proxies. Such proxies
+     * carry the full shutter bounds from Object::compute_bounds(); their BLAS
+     * may still contain native motion primitives and sliced time intervals.
+     * Only the actual TLAS references below are candidates for reconstruction. */
+    for (const BVHReference &r : builder.references) {
+      const BoundBox &b = r.bounds();
+      const Ref ref{{b.min.x, b.min.y, b.min.z},
+                    {b.max.x, b.max.y, b.max.z},
+                    r.prim_index(),
+                    r.prim_object(),
+                    r.prim_type(),
+                    builder.object_visibility(r.prim_object())};
+      if (!supported(ref) || r.time_from() != 0.0f || r.time_to() != 1.0f ||
+          (!live.empty() && !(key(live.back()) < key(ref))))
+      {
+        const bool motion = (r.prim_type() & PRIMITIVE_MOTION) != 0 || r.time_from() != 0.0f ||
+                            r.time_to() != 1.0f;
+        std::fprintf(stderr,
+                     "FRAMEPIPE_BVH miss=%s stage=input refs=%zu cap=%zu limit=%zu type=%d\n",
+                     motion ? "motion" : "unsupported-input",
+                     refs,
+                     cap,
+                     exchange_limit,
+                     r.prim_type());
+        return nullptr;
+      }
+      live.push_back(ref);
+    }
+    if (!capture.empty() && !framepipe::write_snapshot(capture, live)) {
+      std::fprintf(stderr, "FRAMEPIPE_BVH capture=failed\n");
+    }
+    if (busy) {
+      return nullptr;
+    }
+    const size_t expected_time = ready && builder.params.use_motion_steps() ?
+                                     ready->source.size() :
+                                     0;
+    if (ready && ready->target == s.generation && ready->root &&
+        ready->time.size() != expected_time)
+    {
+      /* The producer's native builder must have supplied the current TLAS
+       * time layout before pack_instances() appends the current frame's BLAS. */
+      std::fprintf(stderr,
+                   "FRAMEPIPE_BVH miss=time-layout refs=%zu expected=%zu got=%zu\n",
+                   refs,
+                   expected_time,
+                   ready->time.size());
+    }
+    else if (ready && ready->target == s.generation && ready->root) {
+      const bool identity =
+          ready->source.size() == live.size() &&
+          std::equal(live.begin(), live.end(), ready->source.begin(), framepipe::same_identity);
+      if (identity) {
+        const bool exact = std::equal(
+            live.begin(), live.end(), ready->source.begin(), framepipe::same_input);
+        if (!exact) {
+          refit(*ready->root, live, ready->input_for_slot);
+        }
+        builder.prim_type.steal_data(ready->type);
+        builder.prim_index.steal_data(ready->index);
+        builder.prim_object.steal_data(ready->object);
+        builder.prim_time.steal_data(ready->time);
+        result = std::move(ready->root);
+        std::fprintf(
+            stderr, "FRAMEPIPE_BVH hit=%s refs=%zu\n", exact ? "exact" : "refit", live.size());
+      }
+      else {
+        std::fprintf(stderr, "FRAMEPIPE_BVH miss=identity\n");
+      }
+    }
+    else {
+      std::fprintf(stderr, "FRAMEPIPE_BVH miss=%s\n", ready ? "stale-or-invalid" : "cold");
+    }
+    ready.reset();
+    const bool last = env_value("CYCLES_FRAMEPIPE_LAST") == "1";
+    if (!last && live.size() <= limit) {
+      auto pending = make_unique<Job>();
+      pending->source = std::move(live);
+      pending->params = builder.params;
+      pending->target = s.generation + 1;
+      pending->cap = cap;
+      pending->limit = limit;
+      pending->next = env_value("CYCLES_FRAMEPIPE_NEXT");
+      s.pending = std::move(pending);
+    }
+    else if (!last && live.size() > limit) {
+      std::fprintf(stderr,
+                   "FRAMEPIPE_BVH miss=memory stage=next refs=%zu cap=%zu limit=%zu\n",
+                   live.size(),
+                   cap,
+                   limit);
+    }
+  }
+  catch (const std::exception &e) {
+    std::fprintf(stderr, "FRAMEPIPE_BVH miss=staging (%s)\n", e.what());
+  }
+  return result;
+}
+
+CCL_NAMESPACE_END
