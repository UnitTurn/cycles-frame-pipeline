diff --git a/intern/cycles/util/framepipe_camera_math.h b/intern/cycles/util/framepipe_camera_math.h
new file mode 100644
index 00000000..3cddecb9
--- /dev/null
+++ b/intern/cycles/util/framepipe_camera_math.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include "util/projection.h"
+
+CCL_NAMESPACE_BEGIN
+
+#ifdef WITH_FRAMEPIPE_RELEASE_CAMERA_MATH
+/* The Windows compatibility build shares only POD pointers with the release
+ * compiler. Keep Blender/Cycles classes and their allocators in the host ABI. */
+extern "C" void ccl_framepipe_camera_strip_scale(const Transform *input, Transform *result);
+extern "C" void ccl_framepipe_camera_project(float fov, float nearclip, float farclip,
+                                             ProjectionTransform *result);
+
+inline Transform framepipe_camera_clear_scale(const Transform &input)
+{
+  Transform result;
+  ccl_framepipe_camera_strip_scale(&input, &result);
+  return result;
+}
+inline ProjectionTransform framepipe_camera_perspective(float fov, float nearclip, float farclip)
+{
+  ProjectionTransform result;
+  ccl_framepipe_camera_project(fov, nearclip, farclip, &result);
+  return result;
+}
+#else
+inline Transform framepipe_camera_clear_scale(const Transform &input)
+{
+  return transform_clear_scale(input);
+}
+inline ProjectionTransform framepipe_camera_perspective(float fov, float nearclip, float farclip)
+{
+  return projection_perspective(fov, nearclip, farclip);
+}
+#endif
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/util/framepipe_camera_math.cpp b/intern/cycles/util/framepipe_camera_math.cpp
new file mode 100644
index 00000000..e0bd952f
--- /dev/null
+++ b/intern/cycles/util/framepipe_camera_math.cpp
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "util/framepipe_camera_math.h"
+
+CCL_NAMESPACE_BEGIN
+
+static_assert(sizeof(Transform) == 12 * sizeof(float));
+static_assert(sizeof(ProjectionTransform) == 16 * sizeof(float));
+
+extern "C" void ccl_framepipe_camera_strip_scale(const Transform *input, Transform *result)
+{
+  *result = transform_clear_scale(*input);
+}
+
+extern "C" void ccl_framepipe_camera_project(float fov, float nearclip, float farclip,
+                                            ProjectionTransform *result)
+{
+  *result = projection_perspective(fov, nearclip, farclip);
+}
+
+CCL_NAMESPACE_END
