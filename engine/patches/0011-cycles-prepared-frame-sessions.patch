+FormalFrame::~FormalFrame() = default;
+
+bool FormalFrame::wait_for_ready()
+{
+  std::unique_lock lock(mutex_);
+  changed_.wait(lock, [this] { return ready_ || finished_; });
+  return ready_;
+}
+
+bool FormalFrame::wait_for_sampling()
+{
+  std::unique_lock lock(mutex_);
+  changed_.wait(lock, [this] { return sampling_ || finished_; });
+  return sampling_;
+}
+
+bool FormalFrame::wait_for_finish()
+{
+  std::unique_lock lock(mutex_);
+  changed_.wait(lock, [this] { return finished_; });
+  return success_;
+}
+
+bool FormalFrame::take_previous_tree(Scene &scene, Progress &progress)
+{
+  if (!predecessor_) {
+    return true;
+  }
+  std::unique_lock lock(predecessor_->mutex_);
+  while (!predecessor_->ready_ && !predecessor_->finished_) {
+    predecessor_->changed_.wait_for(lock, std::chrono::milliseconds(20));
+    if (progress.get_cancel()) {
+      return false;
+    }
+  }
+  if (!predecessor_->ready_ || (predecessor_->finished_ && !predecessor_->success_)) {
+    progress.set_error("Previous frame did not prepare its scene");
+    return false;
+  }
+  scene.frame_lookahead = std::move(predecessor_->retained_tree_);
+  if (scene.frame_lookahead) {
+    mark("bvh_handoff");
+  }
+  return true;
+}
+
+bool FormalFrame::begin_sampling(Scene &scene, Progress &progress)
+{
+  {
+    std::lock_guard lock(mutex_);
+    if (finished_) {
+      return false;
+    }
+    /* The immutable device arrays have been populated by scene.update(). The
+     * builder's retained CPU nodes and input evidence are no longer read by
+     * this lane. Move their sole owner; the successor still verifies its own
+     * ordered references and retains its own device arrays. */
+    if (scene.frame_lookahead) {
+      if (scene.bvh && scene.bvh->params.bvh_layout == BVH_LAYOUT_BVH2) {
+        static_cast<BVH2 *>(scene.bvh.get())->frame_lookahead = nullptr;
+      }
+      retained_tree_ = std::move(scene.frame_lookahead);
+    }
+    ready_ = true;
+    mark("prepared");
+  }
+  changed_.notify_all();
+  if (auto pred = std::move(predecessor_)) {
+    std::unique_lock lock(pred->mutex_);
+    while (!pred->finished_) {
+      pred->changed_.wait_for(lock, std::chrono::milliseconds(20));
+      if (progress.get_cancel()) {
+        return false;
+      }
+    }
+    if (!pred->success_) {
+      progress.set_error("Previous prepared frame did not complete");
+      return false;
+    }
+  }
+  return !progress.get_cancel();
+}
+
+void FormalFrame::sample_batch_begin()
+{
+  std::lock_guard lock(mutex_);
+  if (!sampling_ && !finished_) {
+    sampling_ = true;
+    mark("sample_begin");
+    changed_.notify_all();
+  }
+}
+
+void FormalFrame::finish(const bool success)
+{
+  {
+    std::lock_guard lock(mutex_);
+    if (finished_) {
+      return;
+    }
+    success_ = success;
+    finished_ = true;
+    mark("lane_release");
+    if (!success_) {
+      mark("abort");
+    }
+  }
+  changed_.notify_all();
+}
+
+void Session::set_formal_frame(std::shared_ptr<FormalFrame> frame)
+{
+  std::lock_guard lock(formal_sessions_mutex);
+  if (frame) {
+    frame->capture.session.store(this);
+    formal_sessions[this] = std::move(frame);
+  }
+  else {
+    formal_sessions.erase(this);
+  }
+}
