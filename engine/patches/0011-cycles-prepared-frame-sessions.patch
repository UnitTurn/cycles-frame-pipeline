+CCL_NAMESPACE_BEGIN
+
+class Progress;
+class Scene;
+class BVHFrameLookahead;
+class FormalFrame;
+
+/* Formal capture may outlive the Blender call which submitted it. Each lane owns one
+ * immutable destination. Worker and submitter may bind it concurrently. */
+struct NativeFrameCapture {
+  const int frame;
+  const string path;
+  FormalFrame *job;
+  std::atomic<bool> completed{false};
+  std::atomic<const void *> session{nullptr};
+};
+
+inline thread_local NativeFrameCapture *bound_native_capture = nullptr;
+
+class NativeFrameCaptureScope {
+ public:
+  explicit NativeFrameCaptureScope(NativeFrameCapture *capture) : previous_(bound_native_capture)
+  {
+    bound_native_capture = capture;
+  }
+  ~NativeFrameCaptureScope() { bound_native_capture = previous_; }
+  NativeFrameCaptureScope(const NativeFrameCaptureScope &) = delete;
+  NativeFrameCaptureScope &operator=(const NativeFrameCaptureScope &) = delete;
+
+ private:
+  NativeFrameCapture *previous_;
+};
+
+inline void formal_frame_mark_stage(const char *stage)
+{
+  if (bound_native_capture) {
+    std::fprintf(stderr, "READYFRAME frame=%d event=%s owner=%p\n", bound_native_capture->frame,
+                 stage, bound_native_capture->session.load());
+  }
+}
+
+class FormalFrame {
+ public:
+  FormalFrame(int frame, const string &path, std::shared_ptr<FormalFrame> predecessor = {});
+  ~FormalFrame();
+  bool wait_for_ready();
+  bool wait_for_sampling();
+  bool wait_for_finish();
+  bool take_previous_tree(Scene &scene, Progress &progress);
+  bool begin_sampling(Scene &scene, Progress &progress);
+  void sample_batch_begin();
+  void finish(bool success);
+  bool capture_done() const { return capture.completed.load(); }
+  void mark(const char *stage) const
+  {
+    std::fprintf(stderr, "READYFRAME frame=%d event=%s owner=%p\n", frame, stage, capture.session.load());
+  }
+
+  const int frame;
+  NativeFrameCapture capture;
+
+ private:
+  std::shared_ptr<FormalFrame> predecessor_;
+  std::unique_ptr<BVHFrameLookahead> retained_tree_;
+  std::mutex mutex_;
+  std::condition_variable changed_;
+  bool ready_ = false;
+  bool sampling_ = false;
+  bool finished_ = false;
+  bool success_ = false;
+};
+
+CCL_NAMESPACE_END
