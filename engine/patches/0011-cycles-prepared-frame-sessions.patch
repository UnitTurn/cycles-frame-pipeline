+/* The bpy render calls are sequential. Only the isolated Cycles session workers overlap. */
+static struct {
+  BlenderSession *owner = nullptr;
+  std::shared_ptr<FormalFrame> request;
+  std::map<int, std::shared_ptr<FormalFrame>> frames;
+  bool submitted = false;
+} formal_batch;
+
+string BlenderSession::formal_begin(const int frame, const string &capture)
+{
+  if (capture.empty() || formal_batch.frames.count(frame) ||
+      (formal_batch.request && !formal_batch.submitted)) {
+    return "Invalid formal frame or previous render was not submitted";
+  }
+  auto next = std::make_shared<FormalFrame>(frame, capture, formal_batch.request);
+  formal_batch.frames.emplace(frame, next);
+  formal_batch.request = std::move(next);
+  formal_batch.submitted = false;
+  native_frame_set_paths(capture, "", false);
+  return "";
+}
+
+string BlenderSession::formal_collect(const int frame)
+{
+  const auto found = formal_batch.frames.find(frame);
+  if (found == formal_batch.frames.end()) {
+    return "Unknown or already collected formal frame";
+  }
+  if (found->second == formal_batch.request && !formal_batch.submitted) {
+    return "The formal frame was not submitted by the render engine";
+  }
+  const bool ok = found->second->wait_for_finish();
+  formal_batch.frames.erase(found);
+  return ok ? "" : string_printf("Cycles failed to complete formal frame %d", frame);
+}
+
+void BlenderSession::formal_end()
+{
+  if (!formal_batch.request) {
+    return;
+  }
+  if (!formal_batch.submitted) {
+    formal_batch.request->finish(false);
+  }
+  if (BlenderSession *owner = formal_batch.owner) {
+    if (owner->session) {
+      owner->session->wait();
+    }
+    if (owner->other_session_) {
+      owner->other_session_->wait();
+    }
+    owner->other_sync_.reset();
+    owner->other_session_.reset();
+    owner->free_session();
+    owner->scene = nullptr;
+    owner->formal_request_.reset();
+  }
+  formal_batch = {};
+  native_frame_set_paths("", "", false);
+}
 
