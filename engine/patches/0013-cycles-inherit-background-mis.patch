+BackgroundLight *LightManager::enabled_background_light(const Scene &scene)
+{
+  BackgroundLight *last = nullptr;
+  for (const Object *object : scene.objects) {
+    Geometry *geom = object->get_geometry();
+    if (geom && geom->is_light()) {
+      Light *light = static_cast<Light *>(geom);
+      if (light->is_background_light() && light->is_enabled) {
+        last = static_cast<BackgroundLight *>(light);
+      }
+    }
+  }
+  return last;
+}
+
+bool LightManager::inherit_background_history(Scene &dst, const Scene &src)
+{
+  const LightManager &prev = *src.light_manager;
+  if (prev.background_revision == 0 || prev.need_update_background) {
+    return false;
+  }
+  if (background_revision == prev.background_revision) {
+    return true;
+  }
+
+  /* A completed persistent session retains the exact importance bake, including the
+   * camera-space inputs evaluated when that bake occurred. Each lane owns its GPU storage. */
+  const KernelBackground &from = src.dscene.data.background;
+  KernelBackground &to = dst.dscene.data.background;
+  const auto copy_cdf = [](auto &out, const auto &in) {
+    if (in.size() == 0) {
+      out.free();
+      return true;
+    }
+    auto *data = out.alloc(in.size());
+    if (!data || !in.data()) {
+      return false;
+    }
+    std::copy_n(in.data(), in.size(), data);
+    out.tag_modified();
+    return true;
+  };
+  if (!copy_cdf(dst.dscene.light_background_marginal_cdf, src.dscene.light_background_marginal_cdf) ||
+      !copy_cdf(dst.dscene.light_background_conditional_cdf, src.dscene.light_background_conditional_cdf)) {
+    need_update_background = true;
+    return false;
+  }
+  to.sun = from.sun;
+  to.use_sun_guiding = from.use_sun_guiding;
+  to.sun_weight = from.sun_weight;
+  to.map_weight = from.map_weight;
+  to.portal_weight = from.portal_weight;
+  to.map_res_x = from.map_res_x;
+  to.map_res_y = from.map_res_y;
+  to.map_dD = from.map_dD;
+  to.use_mis = from.use_mis;
+  last_background_enabled = prev.last_background_enabled;
+  last_background_resolution = prev.last_background_resolution;
+
+  const BackgroundLight *light = enabled_background_light(src);
+  inherited_radiance = light ? light->get_average_radiance() : -1.0f;
+  background_upload_pending = true;
+  background_revision = prev.background_revision;
+  need_update_background = false;
+  /* Device update must still install the inherited flux in the destination's light tree. */
+  update_flags |= LIGHT_MODIFIED;
+  std::fprintf(stderr, "READYFRAME_WORLD_MIS inherited=%llu entries=%zu average=%.9g\n",
+               (unsigned long long)background_revision, src.dscene.light_background_conditional_cdf.size(),
+               double(inherited_radiance));
+  return true;
+}
