 /* Depsgraph */
+static void engine_graph_evaluate_frame(Depsgraph *depsgraph)
+{
+  if (BLI_getenv("CYCLES_FRAMEPIPE_PRODUCE")) {
+    /* Speculative evaluation must not run production frame-change handlers or
+     * write evaluated values back to original datablocks. Keep recalc on the
+     * private graph for BlenderSync, just as the regular render path does. */
+    BKE_main_view_layers_synced_ensure(DEG_get_bmain(depsgraph));
+    DEG_graph_relations_update(depsgraph);
+    DEG_evaluate_on_framechange(depsgraph,
+                                BKE_scene_frame_get(DEG_get_input_scene(depsgraph)),
+                                DEG_EVALUATE_SYNC_WRITEBACK_NO);
+    return;
+  }
+  BKE_scene_graph_update_for_newframe_ex(depsgraph, false);
+}
