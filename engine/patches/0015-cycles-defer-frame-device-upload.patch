+/* The render depsgraph owns these evaluated meshes. Prime the same lazy host caches queried
+ * by the Cycles exporter, without writing to the current Cycles scene or touching its device. */
+static void warm_deferred_mesh_inputs(blender::Depsgraph &depsgraph)
+{
+  blender::DEGIDIterData iter{};
+  iter.graph = &depsgraph;
+  iter.only_updated = true;
+  std::unordered_set<const blender::Mesh *> visited;
+  ITER_BEGIN (blender::DEG_iterator_ids_begin,
+              blender::DEG_iterator_ids_next,
+              blender::DEG_iterator_ids_end,
+              &iter,
+              blender::ID *,
+              id)
+  {
+    if (GS(id->name) != blender::ID_OB) {
+      continue;
+    }
+    const blender::Object *object = blender::id_cast<blender::Object *>(id);
+    if (object->type != blender::OB_MESH || !object->data ||
+        ((id->recalc | object->data->recalc) & blender::ID_RECALC_GEOMETRY) == 0 ||
+        GS(object->data->name) != blender::ID_ME) {
+      continue;
+    }
+    const blender::Mesh *mesh = blender::id_cast<blender::Mesh *>(object->data);
+    if (mesh->faces_num == 0 || !visited.insert(mesh).second) {
+      continue;
+    }
+    mesh->corner_tris();
+    if (mesh->normals_domain() == blender::bke::MeshNormalDomain::Corner) {
+      mesh->corner_normals();
+    }
+    else {
+      mesh->vert_normals();
+    }
+  }
+  ITER_END;
+}
