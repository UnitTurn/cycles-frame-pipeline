+
+static std::mutex native_frame_mutex;
+static string native_frame_capture;
+static string native_frame_replay;
+static std::atomic<bool> native_frame_capturing(false);
+static std::atomic<bool> native_frame_inline_reference(false);
+static std::atomic<bool> native_frame_completed(false);
+
+void native_frame_set_paths(const string &capture, const string &replay, const bool inline_reference)
+{
+  std::lock_guard<std::mutex> lock(native_frame_mutex);
+  native_frame_capture = capture;
+  native_frame_replay = replay;
+  native_frame_completed.store(false);
+  native_frame_inline_reference.store(inline_reference);
+  native_frame_capturing.store(!capture.empty());
+}
+
+bool native_frame_is_capturing()
+{
+  return native_frame_capturing.load(std::memory_order_relaxed);
+}
+
+bool native_frame_is_inline_reference()
+{
+  return native_frame_inline_reference.load(std::memory_order_relaxed);
+}
+
+string native_frame_capture_path()
+{
+  std::lock_guard<std::mutex> lock(native_frame_mutex);
+  return native_frame_capture;
+}
+
+string native_frame_replay_path()
+{
+  std::lock_guard<std::mutex> lock(native_frame_mutex);
+  return native_frame_replay;
+}
+
+void native_frame_mark_complete()
+{
+  native_frame_completed.store(true);
+}
+
+bool native_frame_complete()
+{
+  return native_frame_completed.load();
+}
 
