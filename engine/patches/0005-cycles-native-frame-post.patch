+static PyObject *native_frame_paths_func(PyObject * /*self*/, PyObject *args)
+{
+  const char *capture;
+  const char *replay;
+  int inline_reference = 0;
+  if (!PyArg_ParseTuple(args, "ss|p", &capture, &replay, &inline_reference)) {
+    return nullptr;
+  }
+  if (*capture && *replay) {
+    PyErr_SetString(PyExc_ValueError, "Capture and replay must run in separate workers");
+    return nullptr;
+  }
+  if (inline_reference && !*capture) {
+    PyErr_SetString(PyExc_ValueError, "Inline reference requires a capture file");
+    return nullptr;
+  }
+  native_frame_set_paths(capture, replay, inline_reference != 0);
+  Py_RETURN_NONE;
+}
+
+static PyObject *native_frame_done_func(PyObject * /*self*/, PyObject * /*args*/)
+{
+  return PyBool_FromLong(native_frame_complete());
 }
 
