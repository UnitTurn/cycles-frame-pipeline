+device_image *ImageCache::clone_full(Device &device, const device_image &source, uint &image_info_id)
+{
+  device_image &copy = alloc_full(device,
+                                  ImageDataType(source.info.data_type),
+                                  InterpolationType(source.info.interpolation),
+                                  ExtensionType(source.info.extension),
+                                  source.data_width, source.data_height, image_info_id);
+  if (!copy.host_pointer) {
+    return nullptr;
+  }
+  memcpy(copy.host_pointer, source.host_pointer, copy.memory_size());
+  return &copy;
 }
 
