+
+void ImageManager::warm_packed_stills(Device &device, Scene &scene, Scene &source_scene,
+                                      bool (*same_source)(const ImageLoader &, const ImageLoader &))
+{
+  if (scene.params.texture_resolution != source_scene.params.texture_resolution ||
+      scene.params.texture_limit != source_scene.params.texture_limit ||
+      scene.params.use_texture_cache != source_scene.params.use_texture_cache) {
+    return;
+  }
+  ImageManager &source = *source_scene.image_manager;
+  device_resize_image_textures(&scene);
+  size_t count = 0, bytes = 0;
+  for (ImageSingle *dst : images) {
+    if (!dst || !dst->need_load || dst->params.animated || !dst->builtin) {
+      continue;
+    }
+    for (const ImageSingle *orig : source.images) {
+      if (!orig || orig->need_load || orig->need_metadata || !orig->builtin ||
+          !(orig->params == dst->params) || !orig->vdb_memory || !orig->vdb_memory->host_pointer ||
+          !same_source(*dst->loader, *orig->loader) ||
+          (!dst->need_metadata && !(dst->metadata == orig->metadata))) {
+        continue;
+      }
+      KernelImageTexture tex = source_scene.dscene.image_textures[orig->image_texture_id];
+      if (tex.tile_descriptor_offset != KERNEL_TILE_LOAD_NONE || orig->metadata.use_transform_3d) {
+        continue;
+      }
+      uint index;
+      device_image *copy = image_cache.clone_full(device, *orig->vdb_memory, index);
+      if (!copy) {
+        device.set_error("Unable to allocate a private copy of a formal packed texture");
+        return;
+      }
+      tex.image_info_id = index;
+      dst->vdb_memory = copy;
+      dst->metadata = orig->metadata;
+      dst->need_metadata = false;
+      dst->need_load = false;
+      scene.dscene.image_textures[dst->image_texture_id] = tex;
+      scene.dscene.image_textures.tag_modified();
+      ++count;
+      bytes += copy->memory_size();
+      break;
+    }
+  }
+  std::fprintf(stderr, "READYFRAME_PACKED_STILLS reused=%zu bytes=%zu\n", count, bytes);
 }
 
