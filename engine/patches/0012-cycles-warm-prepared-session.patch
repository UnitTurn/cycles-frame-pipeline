+bool BlenderImageLoader::same_packed_still(const ImageLoader &a, const ImageLoader &b)
+{
+  const auto *left = dynamic_cast<const BlenderImageLoader *>(&a);
+  const auto *right = dynamic_cast<const BlenderImageLoader *>(&b);
+  if (!left || !right || !left->packed_version.get() ||
+      left->packed_version.get() != right->packed_version.get() || !left->equals(*right)) {
+    return false;
+  }
+  return left->cached_update_count == left->b_image->runtime->update_count &&
+         left->b_iuser.pass == right->b_iuser.pass && left->b_iuser.layer == right->b_iuser.layer &&
+         left->b_iuser.view == right->b_iuser.view && left->b_iuser.multi_index == right->b_iuser.multi_index &&
+         left->b_iuser.multiview_eye == right->b_iuser.multiview_eye && !BKE_image_is_dirty(left->b_image);
+}
